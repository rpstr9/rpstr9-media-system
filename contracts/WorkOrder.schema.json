{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkOrder",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "WorkOrder"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {}
        },
        "required_quality": {
          "type": "array",
          "items": {}
        },
        "allowed_effects": {
          "type": "array",
          "items": {}
        },
        "budget": {
          "type": [
            "object",
            "null"
          ]
        },
        "due_constraints": {
          "type": [
            "object",
            "null"
          ]
        },
        "owner_instruction_refs": {
          "type": "array",
          "items": {}
        },
        "recurrence_context": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "task_id",
        "requested_output",
        "publication_id",
        "inputs",
        "required_quality",
        "allowed_effects",
        "budget",
        "due_constraints",
        "owner_instruction_refs",
        "recurrence_context"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
