{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicationBlueprint",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "PublicationBlueprint"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "concept_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "selected_concept": {
          "type": "string",
          "minLength": 1
        },
        "reader_need": {
          "type": "string",
          "minLength": 1
        },
        "distinctive_promise": {
          "type": "string",
          "minLength": 1
        },
        "recurring_material": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "available_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions_and_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "failure_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strategy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_status": {
          "enum": [
            "provisional",
            "approved",
            "held",
            "retired"
          ]
        }
      },
      "required": [
        "concept_candidates",
        "selected_concept",
        "reader_need",
        "distinctive_promise",
        "recurring_material",
        "available_resources",
        "constraints",
        "assumptions_and_evidence",
        "failure_conditions",
        "strategy_ref",
        "decision_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
