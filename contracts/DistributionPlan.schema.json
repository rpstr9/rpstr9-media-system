{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DistributionPlan",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "DistributionPlan"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "content_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_contexts": {
          "type": "array",
          "items": {}
        },
        "channel_packages": {
          "type": "array",
          "items": {}
        },
        "permission_checks": {
          "type": "array",
          "items": {}
        },
        "timing_hypotheses": {
          "type": "array",
          "items": {}
        },
        "measurement_requests": {
          "type": "array",
          "items": {}
        },
        "stop_conditions": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "content_ref",
        "target_contexts",
        "channel_packages",
        "permission_checks",
        "timing_hypotheses",
        "measurement_requests",
        "stop_conditions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
