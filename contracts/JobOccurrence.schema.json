{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobOccurrence",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "JobOccurrence"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "occurrence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheduled_for_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "deduplication_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "retry",
            "completed",
            "no-op",
            "skipped",
            "cancelled",
            "blocked",
            "failed"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "lease_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease_expiry": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 0
        },
        "work_order_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_record_refs": {
          "type": "array",
          "items": {}
        },
        "action_refs": {
          "type": "array",
          "items": {}
        },
        "checkpoint_refs": {
          "type": "array",
          "items": {}
        },
        "next_attempt_at": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "outcome_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      },
      "required": [
        "occurrence_id",
        "job_ref",
        "job_version",
        "publication_id",
        "scheduled_for_utc",
        "trigger_identity",
        "deduplication_key",
        "state",
        "attempt_count",
        "lease_owner",
        "lease_expiry",
        "fencing_token",
        "work_order_ref",
        "run_record_refs",
        "action_refs",
        "checkpoint_refs",
        "next_attempt_at",
        "outcome_reason",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
