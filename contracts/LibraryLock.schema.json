{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibraryLock",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "LibraryLock"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruction_inventory": {
          "type": "array",
          "items": {}
        },
        "external_method_locks": {
          "type": "array",
          "items": {}
        },
        "integrity_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "release_id",
        "content_commit",
        "manifest_ref",
        "instruction_inventory",
        "external_method_locks",
        "integrity_status",
        "resolved_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
