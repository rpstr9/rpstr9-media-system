{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetaReview",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "MetaReview"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "period_or_run_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {}
        },
        "cross_skill_patterns": {
          "type": [
            "string",
            "null"
          ]
        },
        "allocation_findings": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluator_findings": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_experiments": {
          "type": [
            "string",
            "null"
          ]
        },
        "protected_change_flags": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "period_or_run_scope",
        "evidence_refs",
        "cross_skill_patterns",
        "allocation_findings",
        "evaluator_findings",
        "proposed_experiments",
        "protected_change_flags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
