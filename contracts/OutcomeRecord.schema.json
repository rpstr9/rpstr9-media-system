{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeRecord",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "OutcomeRecord"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "metric_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_refs": {
          "type": "array",
          "items": {}
        },
        "observation_type": {
          "enum": [
            "observed",
            "estimated",
            "predicted",
            "reviewed",
            "simulated",
            "unavailable"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "window": {
          "type": [
            "object",
            "null"
          ]
        },
        "population": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {}
        },
        "collection_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "missingness": {
          "type": [
            "object",
            "null"
          ]
        },
        "uncertainty": {
          "type": [
            "object",
            "null"
          ]
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "metric_ref",
        "work_refs",
        "observation_type",
        "value",
        "unit",
        "window",
        "population",
        "evidence_refs",
        "collection_method",
        "missingness",
        "uncertainty",
        "simulation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
