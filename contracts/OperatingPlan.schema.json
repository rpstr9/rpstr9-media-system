{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatingPlan",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "OperatingPlan"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_refs": {
          "type": "array",
          "items": {}
        },
        "timezone_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "active_hours_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "budget_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "approval_policy_ref": {
          "type": [
            "object",
            "null"
          ]
        },
        "pause_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "notification_policy": {
          "type": [
            "object",
            "null"
          ]
        },
        "owner_authorization_refs": {
          "type": "array",
          "items": {}
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_version_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "plan_id",
        "plan_version",
        "publication_id",
        "status",
        "job_refs",
        "timezone_policy",
        "active_hours_policy",
        "budget_policy",
        "approval_policy_ref",
        "pause_policy",
        "notification_policy",
        "owner_authorization_refs",
        "effective_from",
        "previous_version_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
