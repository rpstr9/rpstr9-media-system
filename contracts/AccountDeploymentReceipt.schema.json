{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountDeploymentReceipt",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "AccountDeploymentReceipt"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
