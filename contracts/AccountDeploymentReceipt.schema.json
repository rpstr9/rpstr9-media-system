      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "account_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_and_idempotency_key": {
          "type": [
            "object",
            "null"
          ]
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_versions": {
          "type": [
            "object",
            "null"
          ]
        },
        "before_and_after_refs": {
          "type": "array",
          "items": {}
        },
        "per_surface_results": {
          "type": "array",
          "items": {}
        },
        "remote_asset_refs": {
          "type": "array",
          "items": {}
        },
        "confirmation_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_inspection_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "reconciliation_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "restore_state": {
          "type": [
            "string",
            "null"
          ]
        }
