      "required": [
        "account_ref",
        "surface_plan_ref",
        "action_and_idempotency_key",
        "authorization_ref",
        "asset_versions",
        "before_and_after_refs",
        "per_surface_results",
        "remote_asset_refs",
        "confirmation_source",
        "render_inspection_ref",
        "result_state",
        "reconciliation_state",
        "restore_state"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
