{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunPlan",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "RunPlan"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {}
        },
        "dependency_edges": {
          "type": "array",
          "items": {}
        },
        "stop_conditions": {
          "type": "array",
          "items": {}
        },
        "expected_outputs": {
          "type": "array",
          "items": {}
        },
        "planned_effects": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "task_id",
        "steps",
        "dependency_edges",
        "stop_conditions",
        "expected_outputs",
        "planned_effects"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
