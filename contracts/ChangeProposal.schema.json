{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeProposal",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "ChangeProposal"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "object",
            "null"
          ]
        },
        "base_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnosis_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_diff": {
          "type": [
            "object",
            "null"
          ]
        },
        "expected_mechanism": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluation_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "guardrails": {
          "type": "array",
          "items": {}
        },
        "authority_needed": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollback_plan": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "target",
        "scope",
        "base_version",
        "diagnosis_ref",
        "proposed_diff",
        "expected_mechanism",
        "evaluation_plan_ref",
        "guardrails",
        "authority_needed",
        "rollback_plan"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
