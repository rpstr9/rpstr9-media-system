{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeasurementSpec",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "MeasurementSpec"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "metric_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "numerator": {
          "type": [
            "object",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "object",
            "null"
          ]
        },
        "population": {
          "type": [
            "object",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "object",
            "null"
          ]
        },
        "proxy_for": {
          "type": [
            "string",
            "null"
          ]
        },
        "missingness_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution_limitations": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "metric_id",
        "objective_ref",
        "definition",
        "unit",
        "numerator",
        "denominator",
        "population",
        "source",
        "window",
        "proxy_for",
        "missingness_policy",
        "attribution_limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
