{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategyContext",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "StrategyContext"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_strategy_refs": {
          "type": "array",
          "items": {}
        },
        "approval_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_context": {
          "type": [
            "object",
            "null"
          ]
        },
        "benefit_or_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_constraints": {
          "type": [
            "object",
            "null"
          ]
        },
        "unresolved_fields": {
          "type": "array",
          "items": {}
        },
        "method_dependency_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_strategy_refs",
        "approval_status",
        "purpose",
        "target_context",
        "benefit_or_value",
        "identity_constraints",
        "unresolved_fields",
        "method_dependency_ref"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
