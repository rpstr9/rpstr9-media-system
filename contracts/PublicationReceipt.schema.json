{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicationReceipt",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "PublicationReceipt"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {}
        },
        "result_status": {
          "enum": [
            "prepared",
            "scheduled",
            "submitted",
            "confirmed",
            "failed",
            "unknown",
            "blocked",
            "not-sent",
            "user-reported",
            "simulation"
          ]
        },
        "remote_id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "remote_url": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "reconciliation_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_target": {
          "type": [
            "object",
            "null"
          ]
        },
        "confirmation_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_media_mappings": {
          "type": "array",
          "items": {}
        },
        "render_verification": {
          "type": [
            "object",
            "null"
          ]
        },
        "verified_content_and_asset_versions": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "action_id",
        "idempotency_key",
        "channel",
        "content_version",
        "authorization_ref",
        "attempts",
        "result_status",
        "remote_id",
        "remote_url",
        "completed_at",
        "reconciliation_state",
        "evidence_ref",
        "operation",
        "account_ref",
        "parent_target",
        "confirmation_source",
        "remote_media_mappings",
        "render_verification",
        "verified_content_and_asset_versions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
