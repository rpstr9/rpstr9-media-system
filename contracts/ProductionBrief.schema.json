{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionBrief",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "ProductionBrief"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "creative_brief_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_specs": {
          "type": "array",
          "items": {}
        },
        "lock": {
          "type": "array",
          "items": {}
        },
        "guide": {
          "type": "array",
          "items": {}
        },
        "free": {
          "type": "array",
          "items": {}
        },
        "forbid": {
          "type": "array",
          "items": {}
        },
        "continuity_rules": {
          "type": "array",
          "items": {}
        },
        "technical_requirements": {
          "type": [
            "object",
            "null"
          ]
        },
        "inspection_plan": {
          "type": [
            "object",
            "null"
          ]
        },
        "asset_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_version_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_and_representation_rules": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "creative_brief_ref",
        "asset_specs",
        "lock",
        "guide",
        "free",
        "forbid",
        "continuity_rules",
        "technical_requirements",
        "inspection_plan",
        "asset_plan_ref",
        "identity_version_ref",
        "source_and_representation_rules"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
