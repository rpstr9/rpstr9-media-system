{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudienceInsight",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "AudienceInsight"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_id_or_system_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public-synthetic",
        "publication-private",
        "maintainer-private",
        "approved-for-public"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {}
        },
        "hypotheses": {
          "type": "array",
          "items": {}
        },
        "segments_if_supported": {
          "type": "array",
          "items": {}
        },
        "evidence_refs": {
          "type": "array",
          "items": {}
        },
        "coverage_limits": {
          "type": [
            "object",
            "null"
          ]
        },
        "implications": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "question",
        "observations",
        "hypotheses",
        "segments_if_supported",
        "evidence_refs",
        "coverage_limits",
        "implications"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_type",
    "record_id",
    "schema_version",
    "created_at",
    "publication_id_or_system_scope",
    "provenance_refs",
    "data_classification",
    "payload"
  ],
  "additionalProperties": false
}
